# Outlook 邮箱管理模块配置（复制为 .env 后按需修改）

# 内部通信密钥（需与 Python 侧 MAIL_INTERNAL_SECRET 一致）
MAIL_INTERNAL_SECRET=auto-traces-mail-internal

# 主服务回调地址（令牌失效→自动切号排除；主进程拉起 Node 时会自动注入 MAIN_API_BASE）
# MAIN_API_BASE=http://127.0.0.1:8000
# MAIN_API_HOST=127.0.0.1
# MAIN_API_PORT=8000

# 令牌自动刷新（由主服务 mail_integration 后台线程调度；约每 skip_days 天刷一次）
# MAIL_TOKEN_REFRESH_ENABLED=1
# MAIL_TOKEN_REFRESH_TICK_SEC=86400
# MAIL_TOKEN_REFRESH_SKIP_DAYS=20

# 旧版独立密码（集成到主系统后通常留空）
PASSWORD=

# 内部服务端口（由 mail_integration.py 自动设置，独立运行时生效）
MAIL_MODULE_PORT=3100
MAIL_MODULE_HOST=127.0.0.1

# 日志
LOG_LEVEL=info

# Redis 缓存（可选，USE_REDIS=1 启用）
# USE_REDIS=1
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 应用名称
API_NAME=MS_OAuth2API_Next
